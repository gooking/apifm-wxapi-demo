<van-cell-group title="用户名注册登录">
  <van-cell title="注册" is-link url="/pages/login/username-register" />
  <van-cell title="登录" is-link url="/pages/login/username-login" />
</van-cell-group>
<van-cell-group title="小程序注册">
  <button type="primary" open-type="getUserInfo" bindgetuserinfo="register_simple">简易注册</button>
  <button type="primary" open-type="getUserInfo" bindgetuserinfo="register_complex">详细注册</button>
  <button type="warn" bindtap="goLogin">登录</button>
</van-cell-group>
<van-cell-group title="其他">
  <button type="primary" bindtap="idcardCheck">实名认证</button>
  <button type="primary" bindtap="openid">获取openid / unionid</button>
  <button type="primary" bindtap="modifyUserInfo">编辑用户资料</button>
  <button type="primary" bindtap="shippingAddress">收货地址管理</button>
</van-cell-group>
<button type="warn" bindtap="loginout">退出登录</button>

