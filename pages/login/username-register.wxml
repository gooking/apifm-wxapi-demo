<van-field
  model:value="{{ username }}"
  required
  clearable
  label="用户名"
  size="large"
  placeholder="请输入用户名"
/>
<van-field
  model:value="{{ pwd }}"
  required
  clearable
  label="密码"
  size="large"
  placeholder="请输入密码"
  password
/>
<view class="btn-box">
  <van-button type="primary" block bind:click="register_username">注册</van-button>
</view>