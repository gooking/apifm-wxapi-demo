<van-notice-bar
  left-icon="volume-o"
  text="利用 json 接口，制作一个每日说说的案例"
/>
<van-field
  model:value="{{ content }}"
  clearable
  size="large"
  type="textarea"
  autosize="{{ autosize }}"
  placeholder="今日你想说点什么"
/>
<view class="btn-box">
  <van-button type="primary" block bind:click="jsonSetV2">提交</van-button>
</view>

<van-empty wx:if="{{ !jsonList || jsonList.length == 0 }}" description="暂无数据" />
<view wx:for="{{ jsonList }}" wx:key="id">
  <van-cell title="{{ item.dateAdd }}" is-link value="删除" data-id="{{ item.id }}" bind:tap="jsonDeleteV2" />
  <view class="content">
    <text>{{ item.content.msg }}</text>
  </view>
</view>